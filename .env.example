# MongoDB Atlas Vector Search
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/
MONGODB_DB_NAME=rag_database
MONGODB_VECTOR_COLLECTION=documents
MONGODB_METADATA_COLLECTION=documents_metadata
MONGODB_VECTOR_INDEX=vector_index

# Official AICTE reference store (falls back to MONGODB_* when omitted)
AICTE_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/
AICTE_DB_NAME=rag_database
AICTE_VECTOR_COLLECTION=documents
AICTE_METADATA_COLLECTION=documents_metadata
AICTE_VECTOR_INDEX=vector_index

# Private Designer curriculum store
CURRICULUM_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/
CURRICULUM_MONGODB_DB_NAME=curriculum_database
CURRICULUM_MONGODB_VECTOR_COLLECTION=documents
CURRICULUM_MONGODB_METADATA_COLLECTION=documents_metadata
CURRICULUM_MONGODB_VECTOR_INDEX=vector_index

# Development/demo only. Replace with the teammate auth identity provider.
ENABLE_DEMO_IDENTITY_ADAPTER=false

# Groq chat model used to answer from retrieved PDF chunks
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=openai/gpt-oss-20b

# The embedding model must match the model used to create the Atlas vectors.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG answer quality controls
RAG_RETRIEVAL_K=12
RAG_RETRIEVAL_DIRECT_K=8
RAG_RETRIEVAL_FETCH_K=36
RAG_RETRIEVAL_DIVERSITY=0.35
RAG_CONTEXT_CHAR_LIMIT=30000
RAG_ANSWER_MAX_TOKENS=1800
